rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The user's own account doc — currently just the fcmToken field, written by
    // PushTokenRepositoryImpl on sign-up/sign-in and on every app startup for a
    // returning session. Rules for the notes/notifications *subcollections* below
    // don't cover this parent path; without an explicit rule here it falls through
    // to the deny-all catch-all and every fcmToken write is silently rejected.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/notes/{noteId} {

      function isAuthenticated() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth.uid == userId;
      }

      function isVerified() {
        return request.auth.token.email_verified == true;
      }

      function isValidNote() {
        let data = request.resource.data;
        return data.keys().hasAll(['title', 'content', 'userId', 'createdAt', 'updatedAt'])
          && data.title is string
          && data.title.size() <= 500
          && data.content is string
          && data.content.size() <= 50000
          && data.userId == userId;
      }

      // No isValidImage() here — images live in Storage, not Firestore

      allow read: if isAuthenticated()
                  && isOwner()
                  && isVerified();

      allow create: if isAuthenticated()
                    && isOwner()
                    && isVerified()
                    && isValidNote();

      allow update: if isAuthenticated()
                    && isOwner()
                    && isVerified()
                    && isValidNote()
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAuthenticated()
                    && isOwner()
                    && isVerified();
    }

    match /users/{userId}/notifications/{notificationId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read: if isOwner();

      // Notifications are authored server-side only — Cloud Functions write them via the
      // Admin SDK, which bypasses these rules entirely. The client never creates its own
      // inbox entries (that was the old, since-removed behaviour).
      allow create: if false;

      // Clients may mark their own notifications read, and nothing else.
      allow update: if isOwner()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read == true;

      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}